{
  // Tailwind v4 syntax (`@import "tailwindcss" source(none)`, `@custom-variant`, `@theme`)
  // is not valid plain CSS, so VS Code's built-in CSS language server reports false
  // "expected {" / "Unknown at rule" errors. The Tailwind CSS IntelliSense extension
  // (bradlc.vscode-tailwindcss) provides the real diagnostics for these files, so the
  // built-in validator is disabled to avoid the duplicate/false errors.
  "css.validate": false
}
