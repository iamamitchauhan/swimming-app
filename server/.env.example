PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/swimming_app
REDIS_URL=
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,https://app.swimtryout.feteboard.ai,https://swimtryout.feteboard.ai
APP_BASE_URL=http://localhost:8080

# OTP / Token Expiry
OTP_EXPIRES_MINUTES=10
EMAIL_VERIFY_EXPIRES_HOURS=24
INVITATION_EXPIRES_HOURS=48

# AWS SES (Email)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_NAME=Swimming App
SES_FROM_EMAIL=noreply@swimmingapp.com

# Seed
SUPER_ADMIN_EMAIL=superadmin@yopmail.com

# Test data isolation — comma-separated user IDs
TEST_USER_IDS=

# Sentry
# Get the DSN from Project Settings > Client Keys (DSN) in your Sentry project.
# Without it, the SDK initializes but sends nothing.
SENTRY_DSN=https://478206db824cdf8a123887dc5cc91971@o4511926852386816.ingest.us.sentry.io/4511926867263488
# Optional: override the environment tag on events (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=
# Optional: release version string (auto-detected from git if unset).
SENTRY_RELEASE=